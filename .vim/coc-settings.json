{
  "languageserver": {
    "solidity": {
      "command": "nomicfoundation-solidity-language-server",
      "args": ["--stdio"],
      "filetypes": ["solidity"],
      "rootPatterns": ["foundry.toml"]
    },
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "filetypes": [
        "typescript",
        "javascript"
      ],
      "rootPatterns": [
        "tsconfig.json",
        "jsconfig.json",
        "package.json"
      ]
    },
    "rust": {
      "command": "rust-analyzer",
      "filetypes": ["rust"],
      "rootPatterns": ["Cargo.toml"],
      "settings": {
        "rust-analyzer": {
          "completion": {
            "limit": 20
          }
        }
      }
    }
  }
}
